  margin-left: 8px;
  font-size: 18px;
  color: #34d399;
}

.def-scroll {
  flex: 1;
  margin-top: 4px;
  flex-direction: column;
}

.def {
  font-size: 19px;
  color: #c9d1d9;
  line-height: 26px;
}

.note {
  margin-top: 4px;
  font-size: 17px;
  color: #6e7681;
}

.miss {
  width: 100%;
  flex: 1;
  flex-direction: column;
  justify-content: center;
}

.miss-t {
  font-size: 21px;
  color: #e6edf3;
}

.miss-line {
  margin-top: 8px;
  flex-direction: row;
  align-items: center;
}

