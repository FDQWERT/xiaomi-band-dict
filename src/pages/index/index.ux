  justify-content: center;
}

.idle-t {
  font-size: 20px;
  color: #8b949e;
}

.idle-s {
  margin-top: 6px;
  font-size: 16px;
  color: #4b5359;
}

.kb {
  width: 100%;
  height: 200px;
  flex-direction: column;
  justify-content: flex-start;
  margin-bottom: 6px;
}

.kb-row {
  width: 100%;
  height: 56px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 6px;
}

.key {
  width: 58px;
