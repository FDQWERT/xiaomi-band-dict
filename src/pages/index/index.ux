  width: 100%;
  height: 46px;
  flex-direction: row;
  align-items: center;
  border-radius: 12px;
  background-color: #14181b;
  padding: 0 12px;
}

.input-text {
  font-size: 27px;
  font-weight: bold;
  color: #34d399;
  letter-spacing: 4px;
}

